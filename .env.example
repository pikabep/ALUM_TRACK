# Copy to .env and fill in. .env is git-ignored. Only the names reach the model, never the values.
# Free keys: https://aistudio.google.com/apikey  https://console.groq.com/keys  https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: approvals on your phone + chat trigger. Create a bot with @BotFather, message it once,
# then read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

IRCTC_USERNAME=
IRCTC_PASSWORD=

# Optional: the phone forwards OTP SMS to http://<laptop-ip>:7778/inbox with this secret
INBOX_SECRET=
